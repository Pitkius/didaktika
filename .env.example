# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/didaktika?schema=public"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="your-auth-secret-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider (mock | openai)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Feature Flags
FEATURE_AI_TEACHER="true"
FEATURE_AI_INTEGRITY="true"
FEATURE_ADAPTIVE_LEARNING="true"
FEATURE_PROGRAMMING="false"
FEATURE_BILLING="false"
FEATURE_UNDERSTANDING_CHECK="true"
FEATURE_PARENT_PORTAL="false"
FEATURE_SSO="false"

# Email (console | resend)
EMAIL_PROVIDER="console"
EMAIL_FROM="Didaktika <onboarding@resend.dev>"
RESEND_API_KEY=""

# Billing stays closed until signed Stripe webhooks exist. License keys are the paid path.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
